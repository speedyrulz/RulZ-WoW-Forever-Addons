{
  "name": "rulz-wow-forever-addons",
  "productName": "RulZ WoW Forever Addons",
  "version": "1.0.0",
  "description": "RulZ addons for World of Warcraft: Forever, with a black-and-red installer that finds your game folder.",
  "main": "./out/main/index.js",
  "author": "RulZ",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.14",
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.9.3",
    "electron-builder": "26.0.12",
    "electron-vite": "5.0.0",
    "lucide-react": "0.544.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vitest": "4.1.12"
  }
}
